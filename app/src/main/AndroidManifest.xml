<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Required for ScreenCaptureService (foreground service for screen sharing) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Required on Android 13+ (API 33) to show the "Screen sharing active" notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- INTERNET is declared in the samvyo-sdk library manifest and merged in automatically -->

    <application
        android:name=".SamvyoApp"
        android:allowBackup="true"
        android:label="Samvyo Demo"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SDK's foreground service for screen capture on Android 10+. The SDK manifest already
             declares it (merged in); repeated here only to make it visible. The SDK starts and stops
             it itself around the share (NB-31) — the app never starts it.
             android:foregroundServiceType="mediaProjection" is required by Android 10+ (API 29+). -->
        <service
            android:name="io.samvyo.sdk.screen.ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

    </application>

</manifest>
